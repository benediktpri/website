---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import epoikosImg from "../assets/projects/epoikos.png";
import websiteImg from "../assets/projects/website.jpeg";
import agencyImg from "../assets/projects/agency.png";

// The CV diagram is a transparent SVG, inlined via set:html rather than loaded
// as <img>: some browsers composite an <img src="*.svg"> onto opaque white,
// which would hide the banner background behind it.
import cvAdvisorSvg from "../assets/projects/cv_aws.svg?raw";

interface Project {
  title: string;
  meta: string;
  description: string;
  link: { label: string; href: string };
  image?: ImageMetadata;
  svg?: string;
  alt?: string;
  // Optional classes to shrink the banner artwork within its box, e.g.
  // "scale-90" (raster) or "[&>svg]:scale-90" (SVG).
  imgClass?: string;
}

const projects: Project[] = [
  {
    title: "EpOikoS",
    meta: "University project · 2025",
    description:
      "A modular multi-agent simulation framework built on AutoGen, designed to investigate agent interactions and behavior. It was used to replicate the EOS project, a study of Paleolithic human behavior, with LLM agents instead of the original rule-based models.",
    link: { label: "GitHub", href: "https://github.com/epoikos-project" },
    image: epoikosImg,
    alt: "EpOikoS project banner",
    imgClass: "scale-85",
  },
  {
    title: "This Website",
    meta: "Personal project · 2026",
    description:
      "My personal website, built with Astro, showcasing my CV and projects. It follows a clean, simple design and includes a running page with an activity heatmap, powered by a Strava integration.",
    link: { label: "GitHub", href: "https://github.com/benediktpri/website" },
    image: websiteImg,
    alt: "Screenshot of this website",
    imgClass: "scale-[0.92] rounded-md",
  },
  {
    title: "CV Advisor",
    meta: "University project · 2026",
    description:
      "A cloud-native application that helps users identify skill gaps in their CV and provides recommendations for improvement. It runs entirely on AWS services and taught me a lot about cloud development and architecture.",
    link: {
      label: "GitHub",
      href: "https://github.com/benediktpri/ccbda-project",
    },
    svg: cvAdvisorSvg,
    alt: "CV Advisor AWS architecture banner",
  },
  {
    title: "The Agentcy",
    meta: "University project · 2024",
    description:
      "A multi-agent system for developing simple web applications, built before coding agents went mainstream. Only an experimental proof of concept, but looking back, it was maybe ahead of its time.",
    link: {
      label: "GitHub",
      href: "https://github.com/echtermeyer/TheAgentcy",
    },
    image: agencyImg,
    alt: "The Agentcy project banner",
    imgClass: "scale-98",
  },
];
---

<BaseLayout title="Projects — Benedikt Prisett">
  <section class="py-10 sm:py-14">
    <h1 class="text-2xl font-medium text-gray-900">Projects</h1>
    <p class="mt-4 leading-relaxed text-gray-600">
      A few things I've built, from university projects to personal experiments.
      Some successful, some less so, but I learned something from every one of
      them.
    </p>

    <div class="mt-12 space-y-12">
      {
        projects.map((project) => (
          <article class="flex flex-col gap-5 sm:flex-row sm:gap-6">
            {/* Left column: banner + title + meta + link */}
            <div class="shrink-0 sm:w-1/2">
              {project.image ? (
                <div class="aspect-video overflow-hidden rounded-lg bg-stone-200">
                  <Image
                    src={project.image}
                    alt={project.alt ?? ""}
                    width={project.image.width}
                    height={project.image.height}
                    referrerpolicy="no-referrer"
                    class:list={[
                      "h-full w-full object-contain",
                      project.imgClass,
                    ]}
                  />
                </div>
              ) : (
                <div
                  role="img"
                  aria-label={project.alt ?? ""}
                  class:list={[
                    "aspect-video overflow-hidden rounded-lg bg-stone-200 [&>svg]:h-full [&>svg]:w-full",
                    project.imgClass,
                  ]}
                  set:html={project.svg}
                />
              )}
              <h2 class="mt-4 text-lg font-medium text-gray-900">
                {project.title}
              </h2>
              {/* Meta and link, dot-separated on one line */}
              <p class="mt-1 text-sm text-gray-400">
                {project.meta} ·{" "}
                <a
                  href={project.link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-gray-400 hover:text-gray-700"
                >
                  {project.link.label} <span aria-hidden="true">↗</span>
                </a>
              </p>
            </div>

            {/* Right column: description */}
            <div class="sm:flex-1">
              <p class="leading-relaxed text-gray-600">{project.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
